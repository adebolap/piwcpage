# Public site URL encoded in the prayer QR code.
# Leave unset on Vercel and the code uses the domain of the request,
# which is what you want for *.vercel.app and for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://piwcantwerp.be

# Google Apps Script web app that writes prayer requests into Workspace.
# See google-workspace/Code.gs
GOOGLE_APPS_SCRIPT_URL=
PRAYER_SHARED_SECRET=

# Public contact shown on the site. Defaults to antwerpvlamms@gmail.com.
# Set this when the church moves to a Workspace address.
# CONTACT_EMAIL=prayer@your-domain

# Optional. Public Google Calendar id (the part before @group.calendar.google.com,
# or the full calendar id). Agenda is shown in Europe/Brussels.
GOOGLE_CALENDAR_ID=

# Optional. Excel / Google Sheets content feed for the website.
# Upload content/PIWC-Antwerp-website-feed.xlsx, open in Google Sheets,
# share as Anyone with the link → Viewer, then set the spreadsheet id and tab gids.
# CONTENT_SHEET_ID=
# CONTENT_GID_SITE=
# CONTENT_GID_GATHERINGS=
# CONTENT_GID_MISSION=
# CONTENT_GID_WORD=
# CONTENT_GID_GIVING=
# CONTENT_GID_ANNOUNCEMENTS=

# Local testing only. Never set this in production.
# PRAYER_DEV_ACCEPT=true
